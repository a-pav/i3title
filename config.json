// Note: Only leading comments are allowed in this file.
{
    "buffer_size": 1600,
    "max_width": 100,
    "mode_format": "<span fgcolor='black' bgcolor='white' font='italic bold'> %s </span> <span color='#666666'>|</span> ",
    "pipe": "/tmp/i3title.pipe",
    // The following keys correspond to i3status "Universal module options":
    // https://i3wm.org/docs/i3status.html#_universal_module_options
    "format": "<span foreground='#a6f3fd' font='fira code medium 11'>%s</span>",
    "min_width": 1100,
    "align": "left",
    "separator": false
}
