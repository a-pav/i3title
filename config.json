{
    "debug": true,
    "buffer_size": 1500,
    "title_module": {
        "placeholder": "ttlph",
        "format": "<span foreground='#7df0ff' font='11'>%s</span>",
        "max_length": 95,
        "discards": 10,
        "welcome_msg": "Welcome!"
    },
    "filters": [
        [
            "&",
            "&amp;"
        ],
        [
            ">",
            "&gt;"
        ],
        [
            "<",
            "&lt;"
        ],
        [
            "\"",
            "&quot;"
        ],
        [   // remove trailing title of firefox 
            " — Firefox Developer Edition$| — Mozilla Firefox$",
            ""
        ]
    ]
}