// Note: Only leading comments are allowed in this file.
//
// You can use -c, -config, --config options to specify an alternate configuration
// file path for the binary.
//
//     By default, i3title looks for configuration files in the following order:
//
//     1. $XDG_CONFIG_HOME/i3title/config.json
//     2. ~/.config/i3title/config.json
//     3. config.json file residing next to the binary.
//
//     If all above attempts fail, i3title runs with a minimal set of conservative
//     defaults. It automatically saves these defaults to ~/.config/i3title/config.json,
//     giving you a ready-to-edit file for subsequent runs.
//

{
    // The general format for text displayed by i3title.
    //
    // The default is the simple "%s" format, but you can also use Pango markup
    // for more complex styling and formatting:
    //
    //      https://docs.gtk.org/Pango/pango_markup.html#the-span-attributes
    //
    // Other dynamic formatting that you use (e.g. i3toast -f) is wrapped by this
    // format and inherits its attributes unless explicitly overridden.
    "format": "<span foreground='#a6f3fd' font='fira code medium 11'>%s</span>",

    // Format for the i3 mode. The default is "", which disables the feature.
    // To enable it, a format containing "%s" is required. For example, "%s | "
    // displays the mode alongside the title as "[ mode ] | [ title ]".
    // As with "format", you can also use Pango markup for styling and formatting.
    "mode_format": "<span fgcolor='black' bgcolor='white' font='italic bold'> %s </span> <span color='#666666'>|</span> ",

    // The minimum width (in pixels) i3title should occupy.
    // Increasing this moves the title closer to the workspace buttons.
    //
    // Together with "max_width", these control the range of space i3title uses
    // for displaying its content.
    "min_width": 1100,

    // The maximum width (in characters) i3title should occupy.
    // Text longer than this is trimmed.
    //
    // i3bar does not impose a maximum width on the content of a status block, so
    // an unbounded title can extend underneath the workspace buttons. Choose these
    // values carefully: setting "max_width" too high can push a long title underneath
    // the workspace buttons, while setting it too low leaves available space unused.
    "max_width": 100,

    // Text alignment: left (default), center, or right.
    "align": "left",

    // Whether to show the separator after the i3title text. The default is false.
    "separator": false,

    // Path to the named pipe used by i3toast to communicate with i3title.
    // The default is "", which disables the feature.
    "pipe": "/tmp/i3title.pipe",

    // i3title uses a fixed-size buffer. To calculate a tight buffer size in bytes
    // that works with your existing configurations, use the number generated by
    // the following snippet. Change max_width to the value you configured above:
    //
    //     echo $(($(i3status | head -n4 | tail -n1 | wc -c) + max_width * 6))
    //
    // Alternatively, you can use a large value, such as 4096 which is the default.
    "buffer_size": 4096
}
