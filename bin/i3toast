#!/bin/sh

# shellcheck disable=3043 # allow 'local' keyword In POSIX sh

readonly VERSION="@VERSION@"

readonly DEFAULT_TIMEOUT=4

readonly RUN_DIR='/dev/shm/i3toast'
readonly ERASE_PID="$RUN_DIR/erase.pid"
readonly QUEUE_PIDS="$RUN_DIR/queue.pids"

usage() {
	cat <<EOF

NAME
      i3toast - send messages to i3title

SYNOPSIS
      i3toast [OPTIONS]
      STDIN | i3toast [OPTIONS]

OPTIONS
      -m MESSAGE    Display MESSAGE.
      -f FORMAT     Format the message. The FORMAT should contain one %s.
      -o OFFSET     Add OFFSET spaces before the message.
      -T TRIM       Trim the message to TRIM characters.
      -t TIMEOUT    Keep the message for TIMEOUT (default: 4 seconds).
      -i            Mark the message as important. Important messages are queued
                    and displayed one at a time. Transient (unimportant) messages
                    cannot interrupt them while they are running.
      -R            Send the message in RAW MODE.
      -w            Print the configured i3title maximum width.
      -e            Erase the current message.
      -E            Clear the queue and erase the current message.
      -h            Print usage.
      -v            Print version.


STDIN
  When input is provided on stdin, each line is treated as a separate message.

  You can tag the output like i3toast:<flag>[:<payload>] to adjust the
  characteristics of the current stream:

      i3toast:-e           Erase the current message.
      i3toast:-f:FORMAT    Set the message format.
      i3toast:-o:OFFSET    Set the message offset.
      i3toast:-T:TRIM      Set the message trim width.

TIMEOUT
  TIMEOUT may be a single value or two comma-separated values:

      TIMEOUT
      TIMEOUT_MID_STREAM,TIMEOUT_AFTER_EOF

  A single value applies to both cases.

  The first value controls how long intermittent messages remain while the
  stream is still active. The second controls how long the final message
  remains after the input stream reaches EOF.

  Use -1 to keep the message indefinitely until it is explicitly erased
  or overwritten.

  TIMEOUT must be passed as a single argument. Do not include spaces around the
  comma unless you quote the entire argument:

      -t 8,2     # OK
      -t "8, 2"  # OK
      -t 8, 2    # Not OK

  An empty field uses the default timeout:

      -t ,0
          Default timeout while the stream is active, instant timeout after EOF.

      -t 3,
          Timeout after 3 seconds while the stream is active, default timeout
		  after EOF.


  Examples:
      -t 4
          Keep the message(s) for 4 seconds.
      -t -1
          Keep the message(s) indefinitely.
      -t 2,5
          Keep the intermittent messages only for 2 seconds, but keep the final
          one for 5 seconds.
      -t -1,0
          Keep intermittent messages indefinitely, but instantly timeout after
		  the final one.

RAW MODE
  By default, i3title trims messages to the configured max_width and sanitizes
  them for safe display in i3bar. Raw mode (-R) disables both safeguards and
  passes the message directly to i3bar. Use it only when you have complete
  control over the data and can ensure that it is safe to pass through unchanged.

  Raw mode allows FORMAT to be included directly in the MESSAGE:

      i3toast -R -m '<b>Hello</b>'

  Without -R, the markup is displayed literally; with -R, "Hello" is displayed
  in bold.

  Arbitrary data is (mostly) safe in normal mode because it is sanitized:

      head -c 100 /dev/urandom | i3toast

  But the same data passed through raw mode can immediately crash i3bar:

      head -c 100 /dev/urandom | i3toast -R  # Don't do this

EXAMPLES
      i3toast -m "Hello!"
      echo "Hello!" | i3toast
      i3toast -i -m "Important message"
      i3toast -t 5 -o 10 -m "Shown for 5 seconds, offseted by 10 spaces"
EOF
}

setup_env() {
	# shellcheck source=/dev/null
	if [ -n "$XDG_CONFIG_HOME" ]; then
		. "$XDG_CONFIG_HOME/i3title/.env"
	elif [ -n "$HOME" ]; then
		. "$HOME/.config/i3title/.env"
	fi

	: "${I3TITLE_PIPE:?}"
	: "${I3TITLE_MAX_WIDTH:?}"

	if [ ! -d "$RUN_DIR" ]; then
		mkdir -p "$RUN_DIR"
		touch "$QUEUE_PIDS"
	fi
}

parse_flags() {
	important=0
	rawMode=0
	timeout=${DEFAULT_TIMEOUT}        # default
	timeoutSTDIN=${DEFAULT_TIMEOUT}   # default

	set_message ""
	set_format ""
	set_offset 0
	set_trim "$I3TITLE_MAX_WIDTH"

	while [ $# -gt 0 ]; do
		case "$1" in
		-m)
			shift; set_message "$1" ;;
		-t)
			shift
			case "$1" in
			*,*)
				timeoutSTDIN="$(echo "$1" | cut -d',' -f1 | xargs)"
				timeout="$(echo "$1" | cut -d',' -f2 | xargs)"
				;;
			*)
				timeoutSTDIN="$1"
				timeout="$1"
				;;
			esac
			: "${timeoutSTDIN:=${DEFAULT_TIMEOUT}}"
			: "${timeout:=${DEFAULT_TIMEOUT}}"
			;;
		-f)
			shift; set_format "$1" ;;
		-o)
			shift; set_offset "$1" ;;
		-i)
			important=1 ;;
		-w)
			echo "$I3TITLE_MAX_WIDTH"; exit 0 ;;
		-e)
			erase; exit 0 ;;
		-E)
			:>"$QUEUE_PIDS"; erase; exit 0 ;;
		-T)
			shift; set_trim "$1" ;;
		-R)
			rawMode=1 ;;
		-h)
			usage; exit 0 ;;
		-v)
			echo "i3toast $VERSION"; exit 0 ;;
		-*)
			echo "Unknown option: $1"
			echo "Use i3toast -h to print usage."
			exit 1
			;;
		esac

		shift
	done
}

is_important() {
	test "$important" -eq 1
}

set_message() {
	message="$1"
}

set_format() {
	local fmt="$1"
	if [ -z "$fmt" ]; then
		format_left=""
		format_right=""
		format_width=0
	else
		format_left="${fmt%%'%s'*}"
		format_right="${fmt#*'%s'}"

		local wid
		wid="$(printf '%s' "$fmt" | sed -E 's/<\/?[^>]+>//g' | wc -m)"
		if [ "$wid" -ge 2 ]; then
			format_width="$((wid-2))" # len("%s") == 2
		fi
	fi
}

set_offset() {
	offset_width="$1"
	if [ "$offset_width" -eq 0 ]; then
		offset=""
	else
		offset="$(printf '%*s' "$offset_width" '')"
	fi
}

set_trim() {
	trim="$1"
}

# Decide how to proceed execution
decide_process() {
	if is_important; then
		if queue_busy; then
			# Queue self and wait for the wake
			queue_add $$
			kill -s STOP $$
		else
			# Queue self and proceed
			queue_add $$
		fi
	elif queue_busy; then
		# Transient messages are dropped when there's a queue
		exit 0
	#else
	 	# Transient message + empty queue -> proceed
	fi
}

read_stdin() {
	local erase_pid
	_erase() { printf '\n' >"$I3TITLE_PIPE"; }
	_erase_cancel() { kill -s TERM "$erase_pid" >/dev/null 2>&1; }
	_erase_launch() {
		if [ "$timeoutSTDIN" != '-1' ]; then
			(sleep "$timeoutSTDIN"; _erase) &
			erase_pid=$!
		fi
	}

	while IFS= read -r line || [ -n "$line" ]; do
		if queue_busy && [ "$(queue_top)" != $$ ]; then
			_erase_cancel
			continue # skip
		fi

		case "$line" in
		i3toast:-e )
			_erase_cancel
			_erase
			continue
			;;
		i3toast:-o:* )
			set_offset "${line#'i3toast:-o:'}"
			;;
		i3toast:-f:* )
			set_format "${line#'i3toast:-f:'}"
			;;
		i3toast:-T:* )
			set_trim "${line#'i3toast:-T:'}"
			;;
		* )
			set_message "${line}"
			;;
		esac

		_erase_cancel

		send

		_erase_launch

	done </dev/stdin

	_erase_cancel
}

send() {
	printf '%s\036%s\036%s\036%s\036%s\036%s\n' \
		"${offset}${format_left}" \
		"${format_right}" \
		"$((format_width+offset_width))" \
		"${trim}" \
		"${rawMode}" \
		"${message}" >"$I3TITLE_PIPE"
}

erase() {
	rm "$ERASE_PID" >/dev/null 2>&1
	printf '\n' >"$I3TITLE_PIPE"
}

# Launch the erase job
erase_launch() {
	if [ "$timeout" != '-1' ]; then
		( sleep "$timeout"; erase ) &
		echo $! >"$ERASE_PID"
		wait $!
	fi
}

# Cancel the pending erase job
erase_cancel() {
	if [ -f "$ERASE_PID" ]; then
		local pid; pid="$(cat "$ERASE_PID")"
		rm "$ERASE_PID"
		kill -s TERM "$pid"
	fi
}

# Check whether the queue is busy
queue_busy() {
	test -s "$QUEUE_PIDS"
}

# Add pid to the queue
queue_add() {
	echo "$1" >>"$QUEUE_PIDS"
}

# Remove pid from the queue
queue_pop() {
	sed -i '/^'"$1"'$/d' "$QUEUE_PIDS"
}

# Echo pid at the top of the queue
queue_top() {
	head -n1 "$QUEUE_PIDS"
}

# Wake the next process in queue
queue_next() {
	local next_pid; next_pid="$(queue_top)"
	if [ -n "$next_pid" ] && kill -0 "$next_pid"; then
		kill -s CONT "$next_pid"
	fi
}

main() {
	setup_env
	parse_flags "$@"

	decide_process

	erase_cancel
	if [ -p /dev/stdin ]; then
		read_stdin
	else
		send # One-shot message
	fi
	erase_launch

	if is_important; then
		queue_pop $$
		queue_next
	fi
}

main "$@"
