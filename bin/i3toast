#!/bin/sh

# shellcheck disable=3043 # allow 'local' keyword In POSIX sh

readonly RUN_DIR='/dev/shm/i3toast'
readonly ERASE_PID="$RUN_DIR/erase.pid"
readonly QUEUE_PIDS="$RUN_DIR/queue.pids"

setup_env() {
	# shellcheck source=/dev/null
	if [ -n "$XDG_CONFIG_HOME" ]; then
		. "$XDG_CONFIG_HOME/i3title/.env"
	elif [ -n "$HOME" ]; then
		. "$HOME/.config/i3title/.env"
	fi

	: "${I3TITLE_PIPE:?}"
	: "${I3TITLE_MAX_WIDTH:?}"

	if [ ! -d "$RUN_DIR" ]; then
		mkdir -p "$RUN_DIR"
		touch "$QUEUE_PIDS"
	fi
}

parse_flags() {
	important=0 # default
	timeout=3   # default

	while [ $# -gt 0 ]; do
		case "$1" in
		-m)
			shift; message="$1" ;;
		-t)
			shift; timeout="$1" ;;
		-f)
			shift; format="$1" ;;
		-i)
			important=1 ;;
		-w)
			echo "$I3TITLE_MAX_WIDTH"; exit 0 ;;
		-r)
			erase; : >"$QUEUE_PIDS"; exit 0;;
		-*)
			echo "Unknown option $1"
			exit 1
			;;
		esac

		shift
	done
}

# Decides how to proceed execution
decide_process() {
	if [ "$important" -eq 1 ]; then
		if queue_busy; then
			# Queue self and wait for the wake
			echo $$ >>"$QUEUE_PIDS"
			kill -s STOP $$
		else
			# Queue self and proceed
			echo $$ >>"$QUEUE_PIDS"
		fi
	elif queue_busy; then
		# Regular, transient messages are dropped when there's a queue
		exit 0
	fi
}

handle_stdin() {
	while IFS= read -r line || [ -n "$line" ]; do
		case "$line" in
		format:* )
			format="${line#'format:'}"
			;;
		message:* | * )
			message="${line#'message:'}"
			;;
		esac

		send

	done </dev/stdin
}

send() {
	if [ -n "$format" ]; then
		local esc_msg
		esc_msg="$(printf '%s' "$message" | sed 's/[&/\]/\\&/g')"
		message="$(printf '%s' "$format" | sed "s/%s/$esc_msg/")"
	fi

	printf '%s\n' "$message" >"$I3TITLE_PIPE"
}

erase() {
	printf '\n' >"$I3TITLE_PIPE"

	if [ -f "$ERASE_PID" ]; then
		rm "$ERASE_PID"
	fi
}

# Setup erase job
setup_erase() {
	if [ "$timeout" != '-1' ]; then
		( sleep "$timeout"; erase ) &
		echo $! >"$ERASE_PID"
	fi
}

# Kill the pending erase job
kill_erase() {
	if [ -f "$ERASE_PID" ]; then
		kill -s TERM "$(cat "$ERASE_PID")"
		rm "$ERASE_PID"
	fi
}

queue_busy() {
	test -s "$QUEUE_PIDS"
}

# Remove self from (top of) the queue file
dequeue_self() {
	sed -i '/^'"$$"'$/d' "$QUEUE_PIDS"
}

# Wake the next in queue
wake_next() {
	local next_pid
	next_pid="$(head -n1 "$QUEUE_PIDS")"
	if [ -n "$next_pid" ] && kill -0 "$next_pid"; then
		kill -s CONT "$next_pid"
	fi
}

main() {
	setup_env
	parse_flags "$@"

	decide_process

	kill_erase
	if [ -p /dev/stdin ]; then
		handle_stdin
	else
		send # One-shot message
	fi
	setup_erase

	dequeue_self
	wake_next
}

main "$@"
