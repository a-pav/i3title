#!/bin/sh

# shellcheck disable=3043 # allow 'local' keyword In POSIX sh

readonly RUN_DIR='/dev/shm/i3toast'
readonly ERASE_PID="$RUN_DIR/erase.pid"
readonly QUEUE_PIDS="$RUN_DIR/queue.pids"

setup_env() {
	# shellcheck source=/dev/null
	if [ -n "$XDG_CONFIG_HOME" ]; then
		. "$XDG_CONFIG_HOME/i3title/.env"
	elif [ -n "$HOME" ]; then
		. "$HOME/.config/i3title/.env"
	fi

	: "${I3TITLE_PIPE:?}"
	: "${I3TITLE_MAX_WIDTH:?}"

	if [ ! -d "$RUN_DIR" ]; then
		mkdir -p "$RUN_DIR"
		touch "$QUEUE_PIDS"
	fi
}

parse_flags() {
	important=0 # default
	timeout=3   # default

	while [ $# -gt 0 ]; do
		case "$1" in
		-m)
			shift; message="$1" ;;
		-t)
			shift; timeout="$1" ;;
		-f)
			shift; format="$1" ;;
		-i)
			important=1 ;;
		-w)
			echo "$I3TITLE_MAX_WIDTH"; exit 0 ;;
		-e)
			erase; exit 0 ;;
		-E)
			erase; :>"$QUEUE_PIDS"; exit 0 ;;
		-*)
			echo "Unknown option $1"
			exit 1
			;;
		esac

		shift
	done
}

is_important() {
	test "$important" -eq 1
}

# Decide how to proceed execution
decide_process() {
	if is_important; then
		if queue_busy; then
			# Queue self and wait for the wake
			queue_add $$
			kill -s STOP $$
		else
			# Queue self and proceed
			queue_add $$
		fi
	elif queue_busy; then
		# Transient messages are dropped when there's a queue
		exit 0
	#else
	 	# Transient message + empty queue -> proceed
	fi
}

read_stdin() {
	while IFS= read -r line || [ -n "$line" ]; do
		case "$line" in
		format:* )
			format="${line#'format:'}"
			;;
		message:* | * )
			message="${line#'message:'}"
			;;
		esac

		send

	done </dev/stdin
}

send() {
	if [ -n "$format" ]; then
		local esc_msg
		esc_msg="$(printf '%s' "$message" | sed 's/[&/\]/\\&/g')"
		message="$(printf '%s' "$format" | sed "s/%s/$esc_msg/")"
	fi

	printf '%s\n' "$message" >"$I3TITLE_PIPE"
}

erase() {
	rm "$ERASE_PID"
	printf '\n' >"$I3TITLE_PIPE"
}

# Launch the erase job
erase_launch() {
	if [ "$timeout" != '-1' ]; then
		( sleep "$timeout"; erase ) &
		echo $! >"$ERASE_PID"
		wait $!
	fi
}

# Cancel the pending erase job
erase_cancel() {
	if [ -f "$ERASE_PID" ]; then
		local -r pid="$(cat "$ERASE_PID")"
		rm "$ERASE_PID"
		kill -s TERM "$pid"
	fi
}

# Check whether the queue is bussy
queue_busy() {
	test -s "$QUEUE_PIDS"
}

# Add pid to the queue
queue_add() {
	echo "$1" >>"$QUEUE_PIDS"
}

# Remove pid from the queue
queue_pop() {
	sed -i '/^'"$1"'$/d' "$QUEUE_PIDS"
}

# Wake the next process in queue
queue_next() {
	local next_pid
	next_pid="$(head -n1 "$QUEUE_PIDS")"
	if [ -n "$next_pid" ] && kill -0 "$next_pid"; then
		kill -s CONT "$next_pid"
	fi
}

main() {
	setup_env
	parse_flags "$@"

	decide_process

	erase_cancel
	if [ -p /dev/stdin ]; then
		read_stdin
	else
		send # One-shot message
	fi
	erase_launch

	if is_important; then
		queue_pop $$
	fi
	queue_next
}

main "$@"
