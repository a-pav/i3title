#!/bin/sh

# shellcheck disable=3043 # allow 'local' keyword In POSIX sh

readonly VERSION="@VERSION@"

readonly DEFAULT_TIMEOUT=4
readonly DEFAULT_TRANSIT=0.1

readonly RUNDIR=/dev/shm/i3toast
readonly QUEUE_PIDS="$RUNDIR/queue.pids" # No flock: the execution model minimizes the chance of race reasonably well

usage() {
	cat <<'EOF'

NAME
      i3toast - send messages to i3title

SYNOPSIS
      i3toast [OPTIONS]
      STDIN | i3toast [OPTIONS]

OPTIONS
      -m, --message MESSAGE  Display MESSAGE.
      -f, --format FORMAT    Format the message. FORMAT must contain one %s.
      -a, --align ALIGN      Align the message: left, center, or right.
                             Overrides "align" in config.
      -o, --offset OFFSET    Add OFFSET spaces before the message.
      -M, --min-width MINWP  Set the minimum width (in pixels) for the message.
                             Overrides "min_width" in config.
      -W, --max-width MAXWC  Set the maximum width (in characters) for the message.
                             Text longer than this is trimmed.
                             Cannot exceed "max_width" in config.
      -t, --timeout TIMEOUT  Keep the message for TIMEOUT seconds (default: 4).
      -T, --ticker TICK      Enable TICKER mode and set TICK as the minimum display time
	                         (in seconds) per line.
      -R, --raw              Send the message in RAW MODE.
      -i, --important        Mark the message, or stream, as important.
                             Important messages are queued and displayed one at a time.
                             Transient (unimportant) messages cannot interrupt them while
                             they are running. A stream is important until it reaches EOF.
      -w, --widths           Print the configured i3title minimum and maximum widths.
                             Output can be used with eval like: eval $(i3title -w)
      -e, --erase            Erase the current message, as if TIMEOUT had elapsed.
      -E, --clear            Terminate all queued messages and clear the queue (for debugging).
      -h, --help             Print usage.
      -v, --version          Print version.


STDIN
  When input is provided on stdin, each line is treated as a separate message.

  You can tag the output like i3toast:<flag>[:<payload>] to adjust the
  characteristics of the current stream. Each tag takes effect immediately
  and applies to subsequent messages:

      i3toast:-e           Erase the current message.
      i3toast:-f:FORMAT    Set the stream format.
      i3toast:-a:ALIGN     Set the stream alignment.
      i3toast:-o:OFFSET    Set the stream offset.
      i3toast:-M:MINWIDTH  Set the stream minimum width.
      i3toast:-W:MAXWIDTH  Set the stream maximum width.
      i3toast:-T:TICK      Set the stream TICKER mode.

TIMEOUT
  A whole number of seconds (no fractions).

  TIMEOUT may be a single value or two comma-separated values:

      TIMEOUT
      TIMEOUT_MID_STREAM,TIMEOUT_AFTER_EOF

  A single value applies to both cases.

  The first value controls how long intermittent messages remain while the
  stream is still active. The second controls how long the final message
  remains after the input stream reaches EOF.

  Use -1 to keep the message indefinitely until it is explicitly erased
  or overwritten.

  TIMEOUT must be passed as a single argument. Do not include spaces around the
  comma unless you quote the entire argument:

      -t 8,2     # OK
      -t "8, 2"  # OK
      -t 8, 2    # Not OK

  An empty field uses the default timeout:

      -t ,0
          Default timeout while the stream is active, instant timeout after EOF.

      -t 3,
          Timeout after 3 seconds while the stream is active, default timeout
          after EOF.


  Examples:
      -t 4
          Keep the message(s) for 4 seconds.
      -t -1
          Keep the message(s) indefinitely.
      -t 2,30
          Keep the intermittent messages only for 2 seconds, but keep the final
          one for 30 seconds.
      -t -1,0
          Keep intermittent messages indefinitely, but instantly timeout after
          the final one.

TICKER
  -T, --ticker TICK enables ticker mode. TICK sets how long each line rests
  (in seconds, fractions allowed) before it starts rolling to the next. Since
  the stream may have its own pace, each line rests for at least TICK.

  When TICK exceeds TIMEOUT, the message disappears before the next line is shown.

  TICK may be two comma-separated values, TICK,TRANSITION, where TRANSITION
  is how long the roll itself takes (default: 0.1). Quoting rules match TIMEOUT.

  Ticker mode is enabled only when TICK > 0; 0 or an empty first field disables it.

RAW MODE
  By default, i3title trims messages to the configured max_width and sanitizes
  them for safe display in i3bar. Raw mode (-R) disables both safeguards and
  passes the message directly to i3bar. Use it only when you have complete
  control over the data and can ensure that it is safe to pass through unchanged.

  Raw mode allows FORMAT to be included directly in the MESSAGE:

      i3toast -R -m '<b>Hello</b>'

  Without -R, the markup is displayed literally; with -R, "Hello" is displayed
  in bold.

  Arbitrary data is (mostly) safe in normal mode because it is sanitized:

      head -c 100 /dev/urandom | i3toast

  But the same data passed through raw mode can immediately crash i3bar:

      head -c 100 /dev/urandom | i3toast -R  # Don't do this

EXAMPLES
      i3toast -m "Hello"
      echo "Hello" | i3toast
      i3toast -i -m "Important message"
      i3toast -t 5 -o 10 -m "Shown for 5 seconds, offseted by 10 spaces"

EOF
}

# Echo message to stderr, print label with non-empty message
erro() { echo "${1:+i3toast: }$1" >&2; }

setup_env() {
	if [ -n "$XDG_CONFIG_HOME" ]; then
		config_path="$XDG_CONFIG_HOME/i3title/.env"
	elif [ -n "$HOME" ]; then
		config_path="$HOME/.config/i3title/.env"
	fi
	# shellcheck source=/dev/null
	. "${config_path}"         # Source and validate the config
	: "${I3TITLE_PIPE:?}"
	: "${I3TITLE_ALIGN:?}"
	: "${I3TITLE_MIN_WIDTH:?}"
	: "${I3TITLE_MAX_WIDTH:?}"

	exec 3>"${I3TITLE_PIPE}" # Open the pipe for writing and attach fd 3

	if [ ! -d "$RUNDIR" ]; then
		mkdir -p "$RUNDIR"
		touch "$QUEUE_PIDS"
	fi
}

parse_flags() {
	_important=0

	set_timeout  "$DEFAULT_TIMEOUT"
	set_message  ""
	set_align    "$I3TITLE_ALIGN"
	set_minwidth "$I3TITLE_MIN_WIDTH"
	set_offset   0
	set_format   ""
	set_trim     "$I3TITLE_MAX_WIDTH"
	set_ticker 0
	raw_mode=0

	while [ $# -gt 0 ]; do
		case "$1" in
		-m | --message )   shift; set_message  "$1" ;;
		-t | --timeout )   shift; set_timeout  "$1" ;;
		-f | --format )    shift; set_format   "$1" ;;
		-o | --offset )    shift; set_offset   "$1" ;;
		-a | --align )     shift; set_align    "$1" ;;
		-M | --min-width ) shift; set_minwidth "$1" ;;
		-W | --max-width ) shift; set_trim     "$1" ;;
		-T | --ticker )    shift; set_ticker   "$1" ;;
		-R | --raw )       raw_mode=1               ;;
		-i | --important ) _important=1             ;;
		-e | --erase ) erase; exit 0 ;;
		-E | --clear ) queue_clear; erase; exit 0 ;;
		-w | --widths ) grep WIDTH "$config_path"; exit 0 ;;
		-v | --version ) echo "i3toast $VERSION"; exit 0 ;;
		-h | --help ) usage; exit 0 ;;
		-*) erro "unknown option: $1"; erro "use i3toast -h to print usage"; exit 1 ;;
		esac
		shift
	done

	if ticker && [ $raw_mode -eq 1 ]; then
		erro "raw mode and ticker mode cannot be combined (-R and -T)"; exit 1
	fi
}

set_message()  { message="$1";      }
set_offset()   { offset_width="$1"; }
set_trim()     { trim_width="$1";   }
set_minwidth() { min_width="$1";    }

set_timeout() {
	local errmsg="timeout (-t) expects a whole number or a comma-separated pair; got: $1"
	timeoutSTDIN="$DEFAULT_TIMEOUT"
	timeoutEOF="$DEFAULT_TIMEOUT"
	case "$1" in
	"$DEFAULT_TIMEOUT") return # All set
		;;
	*.*) erro "$errmsg"; exit 1 # Reject floating points
		;;
	*,*)
		timeoutSTDIN="$(echo "${1%,*}" | xargs)"
		timeoutEOF="$(echo "${1#*,}" | xargs)"
		;;
	*)
		timeoutSTDIN="$(echo "$1" | xargs)"
		timeoutEOF="$timeoutSTDIN" # Single value applies to both
		;;
	esac
	: "${timeoutSTDIN:=${DEFAULT_TIMEOUT}}"   # Input validation
	: "${timeoutEOF:=${DEFAULT_TIMEOUT}}"
	if nan "$timeoutSTDIN" || nan "$timeoutEOF"; then
		erro "$errmsg"; exit 1
	fi
}

set_ticker() {
	local errmsg="ticker (-T) expects a number or a comma-separated pair; got: $1"
	tickerDISPLAY=0 # Disabled by default
	tickerTRANSIT="$DEFAULT_TRANSIT"
	case "$1" in
	0) return # All set
		;;
	*,*)
		tickerDISPLAY="$(echo "${1%,*}" | xargs)"
		tickerTRANSIT="$(echo "${1#*,}" | xargs)"
		;;
	*)
		tickerDISPLAY="$1"
		tickerTRANSIT="$DEFAULT_TRANSIT"
		;;
	esac
	: "${tickerTRANSIT:=${DEFAULT_TRANSIT}}"   # Input validation
	if [ -z "$tickerDISPLAY" ]; then
		tickerDISPLAY=0 # Disable: a proper display time must be provided
	fi
	if nan "$tickerDISPLAY" || nan "$tickerTRANSIT"; then
		erro "$errmsg"; exit 1
	fi
}
# Check whether the ticker mode is enabled
ticker() { test "$tickerDISPLAY" != 0; }

# Check whether the argument is not a number (NaN)
nan() {
	case "${1#[-+]}" in
    '' | '.' | *.*.* | *[!0-9\.]* ) return 0 ;; # NaN
    * ) return 1 ;; # Integer or floating point
	esac
}

set_format() {
	local fmt="$1"
	if [ -z "$fmt" ]; then
		format_left=""
		format_right=""
		format_width=0
	else
		format_left="${fmt%%'%s'*}"
		format_right="${fmt#*'%s'}"

		local wid; wid="$(printf '%s' "$fmt" | sed -E 's/<\/?[^>]+>//g' | wc -m)"
		if [ "$wid" -ge 2 ]; then
			format_width="$((wid-2))" # len("%s") == 2
		fi
	fi
}

set_align() {
	align="$I3TITLE_ALIGN" # Default
	case "$1" in
	"$I3TITLE_ALIGN" ) return ;; # All set
	l* ) align=0 ;; # left
	c* ) align=1 ;; # center
	r* ) align=2 ;; # right
	esac
}

# Decide how to proceed execution
decide_process() {
	if important; then
		if queue_busy; then # Queue self and wait for the wake
			queue_add $$
			kill -s STOP $$
		else # Queue self and proceed
			queue_add $$
		fi
	elif queue_busy && [ ! -p /dev/stdin ]; then
		exit 0 # One-shot messages are dropped when there's a queue
	#else
	 	# Transient message + empty queue -> proceed
	fi
}

read_stdin() {
	ARS="$(printf '\036')"
	prevMsg=""

	while IFS= read -r line || [ -n "$line" ]; do
		if queue_busy && ! important; then
			continue # Unimportant piped messages are dropped when there's a queue
		fi

		parse_stdin "$line"
		local rc=$?
		case $rc in
		0)
			if ! ticker; then
				send "$timeoutSTDIN" # Common path
			else
				if [ "$tickerTRANSIT" != 0 ]; then
					set_message "${prevMsg}${ARS}${line}"
					send "$timeoutSTDIN"
					sleep "$tickerTRANSIT"
					set_message "${line}"
				fi
				send "$timeoutSTDIN"
				sleep "$tickerDISPLAY"
			fi
			prevMsg="$line"
			;; # message
		1)
			send "$timeoutSTDIN"
			;; # flag
		2)
			continue
			;; # erase
		esac
	done </dev/stdin

	if [ "$timeoutSTDIN" != "$timeoutEOF" ]; then
		send "$timeoutEOF"
	fi
}

parse_stdin() {
	# $1: line
	# rc: 0=message/1=flag/2=erase
	local rc=0 # message, the common code

	case "$1" in
	i3toast:-* )
		case "$1" in # Slow path: It's a command, figure out which one
		i3toast:-e   ) erase;                           rc=2 ;;
		i3toast:-f:* ) set_format   "${1#i3toast:-f:}"; rc=1 ;;
		i3toast:-a:* ) set_align    "${1#i3toast:-a:}"; rc=1 ;;
		i3toast:-o:* ) set_offset   "${1#i3toast:-o:}"; rc=1 ;;
		i3toast:-M:* ) set_minwidth "${1#i3toast:-M:}"; rc=1 ;;
		i3toast:-W:* ) set_trim     "${1#i3toast:-W:}"; rc=1 ;;
		i3toast:-T:* ) set_ticker   "${1#i3toast:-T:}"; rc=1 ;;
		*            ) set_message  "${1}" ;; # Catch the error a message
		esac ;;
	* )
		set_message "$1" ;; # Common path
	esac

	return $rc
}

send() {
	# $1: timeout
	printf '%s\036%s\036%s\036%s\036%s\036%s\036%s\036%s\036%s\036%s\n' \
		"${1}" \
		"${align}" \
		"${min_width}" \
		"${offset_width}" \
		"${format_left}" \
		"${format_right}" \
		"${format_width}" \
		"${trim_width}" \
		"${raw_mode}" \
		"${message}" >&3
}

erase() { send 0; }

important()  { test "$_important" -eq 1; }
# Check whether the queue is busy (an important message is running)
queue_busy() { test -s "$QUEUE_PIDS"; }
# Add pid to the queue
queue_add()  { echo "$1" >>"$QUEUE_PIDS"; }
# Remove pid from the queue
queue_pop()  { sed -i '/^'"$1"'$/d' "$QUEUE_PIDS"; }
# Wake the next process in queue
queue_next() {
	local next_pid; next_pid="$(head -n1 "$QUEUE_PIDS")"
	if [ -n "$next_pid" ] && kill -0 "$next_pid"; then
		kill -s CONT "$next_pid"
	fi
}
# Terminate all queued processes and clear the queue (for debugging)
queue_clear() {
	while IFS= read -r pid; do
        kill -TERM "$pid" 2>/dev/null
        kill -CONT "$pid" 2>/dev/null
    done <"$QUEUE_PIDS"
    : >"$QUEUE_PIDS"
}

# shellcheck disable=2120 # indirect argument is passed with trap statement
cleanup() {
	local exit_code=$?
	local signaled="${1:-0}"

	if [ "$signaled" -eq 1 ]; then
		erase
	fi

	if important; then
		if [ "$signaled" -eq 0 ] && [ "$timeoutEOF" != '-1' ]; then
		# Important messages should define a timeout, otherwise they'll remain
		# in the queue and therefore halt or drop other messages.
			sleep "$timeoutEOF"
		fi
		queue_pop $$
		queue_next
	fi

	exit "$exit_code"
}

main() {
	setup_env
	parse_flags "$@"

	decide_process

	trap 'cleanup 1' INT TERM HUP

	if [ -p /dev/stdin ]; then
		read_stdin
	else
		send "$timeoutEOF" # One-shot message
	fi

	cleanup
}

main "$@"
